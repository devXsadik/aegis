.agents/
.claude/
*.mcp.local.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Presentation videos/zips are too large for GitHub HTTPS push (cause 408 timeouts)
presentation/*.mp4
presentation/*.zip
presentation/*.mov
presentation/*.webm

# Evaluation clips and faces show real people — keep local; labels (manifest*.yaml) are fine to commit
data/eval/clips/*
!data/eval/clips/manifest*.yaml
data/eval/civilians/
